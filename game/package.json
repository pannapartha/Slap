    "build:production": "node check-build.mjs && node build-production.mjs",
    "package:server": "node package-server.mjs",
    "test:release": "node release-matrix.mjs",
    "package:vercel": "node package-vercel.mjs",
    "test:production": "node release-production-test.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
