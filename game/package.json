    "build:collision": "node build-collision.mjs && node build-navigation.mjs",
    "build": "node check-build.mjs",
    "test:controls": "node controls-browser.mjs",
    "test:feel": "node pass1-browser.mjs && node check-escape.mjs",
    "test:animation": "node animation-check.mjs",
    "test:visual": "node visual-browser.mjs",
    "test:deadline": "node deadline-presentation.mjs && node deadline-match.mjs",
